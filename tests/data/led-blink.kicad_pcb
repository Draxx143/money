(kicad_pcb
  (version 20240101)
  (generator "pcbnew")
  (general
    (thickness 1.6)
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (36 "B.SilkS" user "B.Silkscreen")
    (44 "Edge.Cuts" user)
  )
  (setup
    (pad_to_mask_clearance 0)
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")
  (net 3 "LED1")
  (footprint "Capacitor_SMD:C_0805_2012Metric"
    (layer "F.Cu")
    (uuid "11111111-1111-1111-1111-111111111111")
    (at 120 60)
    (property "Reference" "C1" (id 0) (at 0 -1.65 0)
      (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "100n" (id 1) (at 0 1.65 0)
      (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Manufacturer" "KEMET")
    (property "MPN" "C0805C104K5RACTU")
    (fp_line (start -1 -0.95) (end 1 -0.95) (layer "F.CrtYd") (width 0.05) (stroke (width 0.05) (type solid)))
    (fp_text reference "REF**" (at 0 -1.65) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" smd roundrect (at -0.9125 0) (size 1.025 1.4) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25) (net 1 "GND") (pinfunction "1") (pintype "passive") (uuid "a1"))
    (pad "2" smd roundrect (at 0.9125 0) (size 1.025 1.4) (layers "F.Cu" "F.Paste" "F.Mask")
      (roundrect_rratio 0.25) (net 2 "VCC") (pinfunction "2") (pintype "passive") (uuid "a2"))
    (model "${KICAD8_3DMODEL_DIR}/Capacitor_SMD.3dshapes/C_0805_2012Metric.wrl"
      (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
  )
  (footprint "LED_SMD:LED_0805_2012Metric"
    (layer "F.Cu")
    (uuid "22222222-2222-2222-2222-222222222222")
    (at 140 60 90)
    (property "Reference" "D1" (id 0) (at 0 -1.65 90))
    (property "Value" "LED_RED" (id 1) (at 0 1.65 90))
    (pad "1" smd roundrect (at -0.9375 0 90) (size 1.025 1.4) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 3 "LED1") (pinfunction "K") (pintype "passive") (uuid "b1"))
    (pad "2" smd roundrect (at 0.9375 0 90) (size 1.025 1.4) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 2 "VCC") (pinfunction "A") (pintype "passive") (uuid "b2"))
  )
  (footprint "Resistor_SMD:R_0805_2012Metric"
    (layer "B.Cu")
    (uuid "33333333-3333-3333-3333-333333333333")
    (at 130 80)
    (property "Reference" "R1" (id 0) (at 0 -1.65 0))
    (property "Value" "330" (id 1) (at 0 1.65 0))
    (pad "1" smd roundrect (at -0.9125 0) (size 1.025 1.4) (layers "B.Cu" "B.Paste" "B.Mask")
      (net 3 "LED1") (pintype "passive") (uuid "c1"))
    (pad "2" smd roundrect (at 0.9125 0) (size 1.025 1.4) (layers "B.Cu" "B.Paste" "B.Mask")
      (net 1 "GND") (pintype "passive") (uuid "c2"))
  )
  (footprint "Connector_TestPoint:TestPoint_Pad_2.0mm"
    (layer "F.Cu")
    (at 150 100)
    (property "Reference" "TP1")
    (property "Value" "TestPoint")
    (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1)
      (layers "*.Cu" "*.Mask") (net 1 "GND") (pinfunction "1") (pintype "passive"))
  )
  (segment (start 120 60) (end 130 60) (width 0.25) (layer "F.Cu") (net 1) (uuid "s1"))
  (segment (start 130 60) (end 140 60) (width 0.25) (layer "F.Cu") (net 2) (uuid "s2"))
  (segment (start 140 60) (end 140 80) (width 0.25) (layer "F.Cu") (net 3) (uuid "s3"))
  (via (at 130 60) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 2) (uuid "v1"))
  (via micro (at 135 70) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 3) (uuid "v2"))
  (zone (net 1) (net_name "GND") (layers "F.Cu")
    (polygon (pts (xy 110 50) (xy 160 50) (xy 160 90) (xy 110 90)))
    (filled_polygon (layer "F.Cu") (pts (xy 110 50) (xy 160 50) (xy 160 90) (xy 110 90)))
