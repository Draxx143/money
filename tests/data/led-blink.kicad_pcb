  (gr_line (start 100 40) (end 170 40) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 170 40) (end 170 110) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 170 110) (end 100 110) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 100 110) (end 100 40) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_text "LED BLINK" (at 135 35) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (gr_circle (center 120 95) (end 125 95) (stroke (width 0.05) (type default)) (layer "F.SilkS"))
)
